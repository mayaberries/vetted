---
import {actions} from "astro:actions";
import "../styles/global.css";
import {googleFontsHref} from "../../../shared/design-tokens.mjs";

export const prerender = false;

const loginResult = Astro.getActionResult(actions.login);
const demoResult = Astro.getActionResult(actions.demoLogin);
if ((loginResult && !loginResult.error) || (demoResult && !demoResult.error)) {
    return Astro.redirect("/");
}
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Sign in · Pets Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href={googleFontsHref} rel="stylesheet"/>
</head>

<body class="bg-base text-ink font-body antialiased min-h-screen flex items-center justify-center px-6">
<div class="w-full max-w-sm bg-surface border border-line rounded-2xl p-8">
    <div class="flex items-center gap-2 mb-6">
        <span class="w-7 h-7 rounded-full bg-teal flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-gold"><circle cx="12" cy="12" r="10"/></svg>
        </span>
        <span class="font-display font-700 text-lg tracking-tight text-ink">Pets Admin</span>
    </div>

    <form method="POST" action={actions.login} class="space-y-4">
        <div>
            <label for="email" class="block text-xs font-medium text-inksoft mb-1.5">Email</label>
            <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="username"
                    class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary"
            />
        </div>

        <div>
            <label for="password" class="block text-xs font-medium text-inksoft mb-1.5">Password</label>
            <input
                    id="password"
                    name="password"
                    type="password"
                    required
                    autocomplete="current-password"
                    class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary"
            />
        </div>

        {loginResult?.error && <p class="text-sm text-red-600">{loginResult.error.message}</p>}

        <button
                type="submit"
                class="w-full bg-ink hover:bg-[#0f211d] text-white font-display font-600 text-sm px-4 py-3 rounded-full transition-colors"
        >
            Sign in
        </button>
    </form>

    <p class="text-center text-sm text-inksoft mt-4">
        New clinic? <a href="/onboarding" class="text-teal font-medium hover:underline">Register and get bookable</a>
    </p>

    <div class="flex items-center gap-3 my-5">
        <div class="h-px bg-line flex-1"></div>
        <span class="text-xs text-inksoft font-mono">or explore without a backend</span>
        <div class="h-px bg-line flex-1"></div>
    </div>

    <form method="POST" action={actions.demoLogin}>
        <button
                type="submit"
                class="w-full border border-line hover:border-teal text-ink text-xs font-medium px-3 py-2.5 rounded-lg transition-colors"
        >
            Demo · Clinic admin
        </button>
    </form>
</div>
</body>
</html>