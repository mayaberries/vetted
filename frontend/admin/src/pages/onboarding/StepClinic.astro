<section class="step-panel" data-step="1">
    <h2 class="font-display font-600 text-xl text-ink mb-1">Your clinic</h2>
    <p class="text-sm text-inksoft mb-6">This becomes the tenant everything else — staff, services, bookings — lives
        under.</p>

    <div class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Clinic name</label>
            <input id="cl_name" type="text" placeholder="Acme Veterinary Clinic"
                   class="w-full px-3.5 py-2.5 rounded-xl border border-line bg-surface focus:outline-none focus:ring-2 focus:ring-teal"/>
            <p class="field-error text-xs text-danger mt-1" data-for="cl_name"></p>
        </div>
        <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Booking page slug</label>
            <div class="flex items-center gap-0 rounded-xl border border-line bg-panel overflow-hidden focus-within:ring-2 focus-within:ring-teal">
                <span class="pl-3.5 pr-1 text-sm text-inksoft font-mono select-none">/sites/</span>
                <input id="cl_slug" type="text" placeholder="acme-vet"
                       class="flex-1 py-2.5 pr-3.5 bg-transparent font-mono text-sm focus:outline-none"/>
            </div>
            <p class="text-xs text-inksoft mt-1">Auto-filled from the name — you can change it now, not later.</p>
            <p class="field-error text-xs text-danger mt-1" data-for="cl_slug"></p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-ink mb-1.5">Clinic email <span
                        class="text-inksoft font-normal">(optional)</span></label>
                <input id="cl_email" type="email" placeholder="hello@acmevet.com"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-line bg-surface focus:outline-none focus:ring-2 focus:ring-teal"/>
            </div>
            <div>
                <label class="block text-sm font-medium text-ink mb-1.5">Phone <span class="text-inksoft font-normal">(optional)</span></label>
                <input id="cl_phone" type="text" placeholder="+52 55 0000 0000"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-line bg-surface focus:outline-none focus:ring-2 focus:ring-teal"/>
            </div>
        </div>
        <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Address <span class="text-inksoft font-normal">(optional)</span></label>
            <input id="cl_address" type="text" placeholder="Street, city"
                   class="w-full px-3.5 py-2.5 rounded-xl border border-line bg-surface focus:outline-none focus:ring-2 focus:ring-teal"/>
        </div>
    </div>
</section>