<section class="step-panel" data-step="0">
    <h2 class="font-display font-600 text-xl text-ink mb-1">Your account</h2>
    <p class="text-sm text-inksoft mb-6">You'll use this to sign in and manage bookings later.</p>

    <div class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Email</label>
            <input id="acc_email" type="email" placeholder="you@yourclinic.com"
                   class="w-full px-3.5 py-2.5 rounded-xl border border-line bg-surface focus:outline-none focus:ring-2 focus:ring-teal" />
            <p class="field-error text-xs text-danger mt-1" data-for="acc_email"></p>
        </div>
        <div>
            <label class="block text-sm font-medium text-ink mb-1.5">Username</label>
            <input id="acc_username" type="text" placeholder="janedoe_vet"
                   class="w-full px-3.5 py-2.5 rounded-xl border border-line bg-surface focus:outline-none focus:ring-2 focus:ring-teal" />
            <p class="text-xs text-inksoft mt-1">3+ characters. Letters, numbers, "-" and "_" only.</p>
            <p class="field-error text-xs text-danger mt-1" data-for="acc_username"></p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-ink mb-1.5">Password</label>
                <input id="acc_password" type="password" placeholder="7+ characters"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-line bg-surface focus:outline-none focus:ring-2 focus:ring-teal" />
                <p class="field-error text-xs text-danger mt-1" data-for="acc_password"></p>
            </div>
            <div>
                <label class="block text-sm font-medium text-ink mb-1.5">Confirm password</label>
                <input id="acc_password2" type="password" placeholder="Repeat password"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-line bg-surface focus:outline-none focus:ring-2 focus:ring-teal" />
                <p class="field-error text-xs text-danger mt-1" data-for="acc_password2"></p>
            </div>
        </div>
    </div>
</section>