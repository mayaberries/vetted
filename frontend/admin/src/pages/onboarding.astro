---
import "../styles/global.css";
import "../styles/onboarding.css";
import { googleFontsHref } from "../../../shared/design-tokens.mjs";
import OnboardingHeader from "./onboarding/OnboardingHeader.astro";
import StepAccount from "./onboarding/StepAccount.astro";
import StepClinic from "./onboarding/StepClinic.astro";
import StepServices from "./onboarding/StepServices.astro";
import StepReview from "./onboarding/StepReview.astro";
import StepSuccess from "./onboarding/StepSuccess.astro";
import OnboardingNav from "./onboarding/OnboardingNav.astro";

export const prerender = false;

const BACKEND_API_URL = import.meta.env.BACKEND_API_URL || "http://localhost:8000/api";
const prefillDemo = Astro.url.searchParams.get("demo") === "1";
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set up your clinic</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={googleFontsHref} rel="stylesheet" />
</head>

<body class="bg-base text-ink font-body antialiased min-h-screen">

<OnboardingHeader apiBaseUrl={BACKEND_API_URL} prefillDemo={prefillDemo} />

<main class="max-w-3xl mx-auto px-6 py-10">

    <!-- Intro (shown only on step 0) -->
    <div id="intro" class="mb-8 rise">
        <p class="text-xs font-mono uppercase tracking-wider text-teal mb-2">Get bookable in a few minutes</p>
        <h1 class="font-display font-700 text-3xl text-ink mb-2">Bring your clinic online</h1>
        <p class="text-inksoft leading-relaxed max-w-xl">
            Create your account, describe your clinic, and list what you offer. At the end you'll get a
            public booking key ready to drop into your own website.
        </p>
    </div>

    <!-- Stepper -->
    <ol id="stepper" class="flex items-center gap-2 mb-8 rise" style="animation-delay:.05s"></ol>

    <!-- Card -->
    <div class="bg-surface border border-line rounded-2xl p-6 sm:p-8 rise" style="animation-delay:.1s">
        <StepAccount />
        <StepClinic />
        <StepServices />
        <StepReview />
        <StepSuccess />
    </div>

    <OnboardingNav />

</main>

<footer class="max-w-3xl mx-auto px-6 pb-12 pt-4">
    <p class="text-xs text-inksoft font-mono">POC onboarding flow — not yet wired into the production auth surface. See notes below.</p>
</footer>

<script>
    import { el, slugify } from "../lib/onboarding/dom.js";
    import { state, newService } from "../lib/onboarding/state.js";
    import { renderServices } from "../lib/onboarding/servicesForm.js";
    import { renderStepper } from "../lib/onboarding/stepper.js";
    import { showStep } from "../lib/onboarding/navigation.js";
    import { validateStep0, validateStep1, validateStep2 } from "../lib/onboarding/validation.js";
    import { launch } from "../lib/onboarding/launch.js";

    el("settingsToggle").addEventListener("click", function () {
        el("settingsPanel").classList.toggle("hidden");
    });

    el("cl_name").addEventListener("input", function () {
        if (!state.slugTouched) el("cl_slug").value = slugify(el("cl_name").value);
    });
    el("cl_slug").addEventListener("input", function () { state.slugTouched = true; });

    el("addServiceBtn").addEventListener("click", function () {
        state.services.push(newService());
        renderServices();
    });

    el("backBtn").addEventListener("click", function () {
        if (state.step > 0) showStep(state.step - 1);
    });

    el("nextBtn").addEventListener("click", function () {
        if (state.step === 0) { if (validateStep0()) showStep(1); return; }
        if (state.step === 1) { if (validateStep1()) showStep(2); return; }
        if (state.step === 2) { if (validateStep2()) showStep(3); return; }
        if (state.step === 3) { launch(); return; }
    });

    renderStepper();
    showStep(0);
</script>

</body>
</html>